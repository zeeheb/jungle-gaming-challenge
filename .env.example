PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering
DB_LOCK_TIMEOUT_MS=5000

SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

CONSUMER_ENABLED=true
CONSUMER_WAIT_TIME_SECONDS=10
CONSUMER_MAX_MESSAGES=10
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE_MS=2000
CONSUMER_RETRY_MAX_MS=60000

OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=500
